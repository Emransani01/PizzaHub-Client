# ---------------------------------------------------------------
# PizzaHub web client - copy this file to client/.env.local
# (or client/.env) and adjust the values. Never commit real secrets.
# ---------------------------------------------------------------

# Base URL of the Express API. Next.js rewrites /api/* to this origin, so the
# Better Auth session cookie stays first-party in the browser.
# Local development:
API_URL=http://localhost:5000

# Production example (current deployed API):
# API_URL=https://pizza-hub-server.vercel.app

# No other variables are required. Every credential (MongoDB, Better Auth
# secret, Stripe, ImgBB, Google OAuth) lives only in server/.env and is never
# exposed to the browser.
